#!/usr/bin/env python3
"""Keep-alive Exchange via the live Streamlit UI only (no Neo4j, no app-repo files).

Pacific day/evening only. Nonlinear gaps under 12h so Community Cloud
does not hibernate. Each visit is a small random burst of searches.
"""

from __future__ import annotations

import json
import math
import os
import random
import re
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

PT = ZoneInfo("America/Los_Angeles")
STATE_PATH = Path(os.environ.get("ALIVE_STATE", ".keepalive-state.json"))
DEFAULT_APP_URL = "https://test-database-nrcan.streamlit.app/"

# Stay under the 12h sleep. Typical gap ~4.5h, never more than 10h.
MEDIAN_HOURS = float(os.environ.get("KEEPALIVE_MEDIAN_HOURS", "4.5"))
SIGMA = float(os.environ.get("KEEPALIVE_SIGMA", "0.35"))
MIN_HOURS = float(os.environ.get("KEEPALIVE_MIN_HOURS", "3"))
MAX_HOURS = float(os.environ.get("KEEPALIVE_MAX_HOURS", "10"))
SLEEP_MIN_S = float(os.environ.get("KEEPALIVE_SLEEP_MIN_S", "12"))
SLEEP_MAX_S = float(os.environ.get("KEEPALIVE_SLEEP_MAX_S", "87"))
NAV_TIMEOUT_MS = int(os.environ.get("KEEPALIVE_NAV_TIMEOUT_MS", "180000"))
WINDOW_START = (8, 0)    # 08:00 PT
WINDOW_END = (21, 30)    # 21:30 PT
BURST_MIN = 2
BURST_MAX = 5
SEARCH_TERMS = (
    "steel",
    "wood",
    "metal",
    "glass",
    "cement",
    "insulation",
    "polymer",
    "roof",
    "tile",
    "masonry",
)


def now_pt() -> datetime:
    return datetime.now(PT)


def minutes_of(hhmm: tuple[int, int]) -> int:
    return hhmm[0] * 60 + hhmm[1]


def in_window(when: datetime) -> bool:
    m = when.hour * 60 + when.minute
    return minutes_of(WINDOW_START) <= m <= minutes_of(WINDOW_END)


def next_morning(after: datetime) -> datetime:
    start = after.replace(
        hour=WINDOW_START[0], minute=WINDOW_START[1], second=0, microsecond=0
    )
    if after >= start:
        start += timedelta(days=1)
    return start + timedelta(minutes=random.uniform(8, 82))


def next_interval(from_when: datetime) -> datetime:
    hours = random.lognormvariate(math.log(MEDIAN_HOURS), SIGMA)
    # weekly sine: some days tighter, some looser (still clamped)
    warp = 0.85 + 0.30 * math.sin(
        (from_when.timetuple().tm_yday + from_when.hour / 24.0) / 7.0 * 2.0 * math.pi
    )
    hours = min(MAX_HOURS, max(MIN_HOURS, hours * warp))
    nxt = from_when + timedelta(hours=hours, minutes=random.uniform(3, 41))
    if not in_window(nxt):
        nxt = next_morning(from_when)
    # overnight from last burst to morning must stay < 12h
    if (nxt - from_when) > timedelta(hours=11):
        eve = from_when.replace(hour=19, minute=0, second=0, microsecond=0)
        eve += timedelta(minutes=random.uniform(10, 100))
        if in_window(eve) and eve > from_when:
            nxt = eve
    return nxt


def load_state() -> dict:
    if not STATE_PATH.exists():
        return {}
    try:
        return json.loads(STATE_PATH.read_text())
    except json.JSONDecodeError:
        return {}


def save_state(state: dict) -> None:
    STATE_PATH.write_text(json.dumps(state, indent=2) + "\n")


def wait_for_streamlit(page) -> None:
    page.locator('[data-testid="stAppViewContainer"]').wait_for(
        timeout=NAV_TIMEOUT_MS
    )


def click_button(page, pattern: str) -> bool:
    rx = re.compile(pattern, re.I)
    btn = page.get_by_role("button", name=rx)
    if btn.count() == 0:
        btn = page.get_by_text(rx)
    if btn.count() == 0:
        return False
    btn.first.click()
    page.wait_for_timeout(2000)
    return True


def visible_text(page) -> str:
    return page.locator('[data-testid="stAppViewContainer"]').inner_text()[:4000]


def run_read_node(page, term: str) -> str:
    search = page.get_by_placeholder(re.compile(r"press enter to submit form", re.I))
    if search.count() == 0:
        search = page.get_by_role("textbox").first
    else:
        search = search.first
    search.click()
    search.fill(term)
    if not click_button(page, r"^search$"):
        search.press("Enter")
    page.wait_for_timeout(2500)
    match = page.get_by_text(re.compile(r"match\(es\) for", re.I))
    if match.count():
        hits = page.get_by_role("button").filter(
            has_not_text=re.compile(
                r"search|add data|clear|user participation|compare|export",
                re.I,
            )
        )
        if hits.count():
            hits.first.click()
            page.wait_for_timeout(2000)
    return f"query term={term}\n{visible_text(page)}"


def run_burst(app_url: str, dry: bool) -> str:
    n = random.randint(BURST_MIN, BURST_MAX)
    terms = random.sample(SEARCH_TERMS, k=min(n, len(SEARCH_TERMS)))
    if dry:
        return f"dry-run burst n={n} terms={terms}"

    from playwright.sync_api import sync_playwright

    chunks = []
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        page = browser.new_page()
        page.goto(app_url, wait_until="domcontentloaded", timeout=NAV_TIMEOUT_MS)
        wait_for_streamlit(page)
        for i, term in enumerate(terms):
            chunks.append(run_read_node(page, term))
            if i < len(terms) - 1:
                # nonlinear pause between queries in the cluster (~8–40s)
                pause = min(48.0, max(7.0, random.lognormvariate(math.log(18), 0.45)))
                time.sleep(pause)
        browser.close()
    return f"burst n={len(terms)}\n" + "\n---\n".join(chunks)


def main() -> None:
    app_url = os.environ.get("APP_URL", "").strip() or DEFAULT_APP_URL
    force = os.environ.get("KEEPALIVE_FORCE", "").lower() in {"1", "true", "yes"}
    dry = os.environ.get("KEEPALIVE_DRY_RUN", "").lower() in {"1", "true", "yes"}

    now = now_pt()
    state = load_state()
    due = datetime.fromisoformat(state["next_due"]) if state.get("next_due") else None
    last = datetime.fromisoformat(state["last_ping"]) if state.get("last_ping") else None
    if due is not None and due.tzinfo is None:
        due = due.replace(tzinfo=PT)
    if last is not None and last.tzinfo is None:
        last = last.replace(tzinfo=PT)

    stale = last is None or (now - last) >= timedelta(hours=10)
    if not force and not in_window(now):
        print(f"skip; outside PT window {now.isoformat()}")
        return
    if not force and due is not None and now < due and not stale:
        print(f"skip until {due.isoformat()}")
        return

    delay = random.uniform(SLEEP_MIN_S, SLEEP_MAX_S)
    print(f"PT {now.isoformat()}; jitter {delay:.1f}s")
    if not dry:
        time.sleep(delay)

    print(run_burst(app_url, dry=dry))

    nxt = next_interval(now)
    save_state(
        {
            "last_ping": now.isoformat(),
            "next_due": nxt.isoformat(),
            "interval_hours": round((nxt - now).total_seconds() / 3600, 2),
        }
    )
    print(f"next due {nxt.isoformat()}")


if __name__ == "__main__":
    main()
